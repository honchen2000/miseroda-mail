{
  "name": "miseroda-mail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "vite",
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "bash scripts/test-batches.sh",
    "test:watch": "vitest",
    "deploy:remote": "wrangler d1 migrations apply DB --remote && wrangler d1 migrations apply DB_FTS --remote && wrangler deploy"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1",
    "hono": "^4.6.0",
    "postal-mime": "^2.4.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@simplewebauthn/browser": "^13.1.0",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "idb-keyval": "^6.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.99.0"
  }
}
